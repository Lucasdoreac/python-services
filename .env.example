REACT_APP=localhost:3000
MONGO_DATABASE=rooms-reservation-app
MONGO_HOST=dwcorp.y5ugild.mongodb.net
MONGO_USERNAME=
MONGO_PASSWORD=
CLOUD_FUNCTION_URL=
CLOUD_FUNCTION_API_KEY=
EMAIL_DRY_RUN=true
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Reservas UDF
FLASK_ENV=development
URL_AUTH=http://127.0.0.1:5050
URL_graph=http://127.0.0.1:5081/graphql
URL_restapi=http://127.0.0.1:5081/restapi
MINIO_URL=dwcorp.com.br:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
SERVER_NAME=labtech.dwcorp.com.br
SERVER_SCHEME=http
# chave que o Catalogo exige em /restapi e /graphql (um item do API_KEY_LIST dele); sem ela a API nao inicia
INTERNAL_API_KEY=
# so em desenvolvimento (FLASK_ENV=development): permite iniciar sem as chaves acima
ALLOW_INSECURE_DEV=false
# proxies que acrescentam X-Forwarded-For antes da API (padrao 1); o IP do cliente e a entrada a essa distancia, da direita
TRUSTED_PROXY_HOPS=1
# janela, em segundos, do limite de pedidos de link de login por cliente (padrao 900)
API_RATE_LIMIT_WINDOW_SECONDS=900
# opcional: segredo que assina os links de PDF enviados por e-mail; vazio = derivado de INTERNAL_API_KEY (trocar a chave invalida os links antigos)
LINK_SIGNING_KEY=
# validade, em dias, desses links (padrao 30)
PDF_LINK_TTL_DAYS=30
