# Configuração da API do Reservas (python-services). Guia completo, com o que é
# obrigatório em produção: docs/CONFIGURACAO.md. O teste src/Tests/env_example_tests.py
# garante que este arquivo lista exatamente as variáveis que o código lê.

# --- ambiente ---
# development = config de dev do Flask; production (padrão se vazio) = produção.
FLASK_ENV=development

# --- MongoDB: use MONGO_URI OU o trio HOST/USERNAME/PASSWORD (Atlas, mongodb+srv) ---
MONGO_URI=mongodb://localhost:27017/
MONGO_HOST=
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_DATABASE=rooms-reservation-app

# --- serviços do shared-resources ---
URL_AUTH=http://127.0.0.1:5050
URL_graph=http://127.0.0.1:5081/graphql/
URL_restapi=http://127.0.0.1:5081/restapi
# chave enviada no header x-api-key ao catálogo; tem de estar no API_KEY_LIST do internal_apis
INTERNAL_API_KEY=

# --- links nos e-mails de aprovação: host público da API (sem esquema) ---
SERVER_NAME=localhost:5000
# esquema desses links; atrás de HTTPS use https
SERVER_SCHEME=http

# --- MinIO (PDF do evento e ícones dos e-mails) ---
# Endereço PÚBLICO com esquema: vai nos links dos e-mails e no caminho gravado do PDF.
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- envio de e-mail (src/settings.py) ---
# true (padrão) = nada é enviado, as rotas devolvem o HTML. Em produção: false.
EMAIL_DRY_RUN=true
# e-mails separados por vírgula; obrigatórios quando EMAIL_DRY_RUN=false
EMAIL_RECIPIENTS_COORDENACAO=
EMAIL_RECIPIENTS_REITORIA=
# Cloud Function que entrega o e-mail; obrigatórias quando EMAIL_DRY_RUN=false
CLOUD_FUNCTION_URL=
CLOUD_FUNCTION_API_KEY=

# --- login (src/settings.py): quem pode pedir link de acesso ---
AUTH_ALLOWED_DOMAIN=udf.edu.br
# exceções individuais, separadas por vírgula (antes fixo em auth_routes.py)
AUTH_ALLOWED_EMAILS=

# --- aulas do semestre bloqueiam sala (src/settings.py, issue #29) ---
# horário de cada período; se não definida, vale o padrão provisório abaixo (até o calendário)
OFFER_PERIOD_HOURS=manhã=07:00-12:00,tarde=13:00-18:00,noite=19:00-23:00
