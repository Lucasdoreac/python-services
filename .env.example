REACT_APP=localhost:3000
MONGO_DATABASE=rooms-reservation-app
MONGO_HOST=dwcorp.y5ugild.mongodb.net
MONGO_USERNAME=
MONGO_PASSWORD=
CLOUD_FUNCTION_URL=
CLOUD_FUNCTION_API_KEY=
EMAIL_DRY_RUN=true
# opcional, para ambientes de teste: enderecos exatos separados por virgula (sem caixa, sem espacos nas pontas). Com ela definida, o /send-email so entrega a esses enderecos e descarta os demais (cada descarte e logado so como impressao HMAC); se nenhum sobrar, nada e enviado e a resposta e 202. Ausente ou vazia: nada muda (Production)
# EMAIL_RECIPIENT_ALLOWLIST=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Reservas UDF
# Opcional: SMTP de contingência; vazio mantém o comportamento atual da Brevo.
# EMAIL_PROVIDER=smtp seleciona SMTP explicitamente; EMAIL_DRY_RUN=true continua sem envio.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Reservas UDF
# STARTTLS é obrigatório: SMTP_STARTTLS=false só vale com FLASK_ENV=development e
# SMTP_HOST local (localhost, 127.0.0.1 ou nome de serviço Docker sem pontos); fora disso o
# envio por SMTP é recusado. A porta 465 usa sempre SMTP_SSL.
# Entrega no máximo uma vez entre provedores: o SMTP só substitui a Brevo quando ela
# certamente não aceitou a mensagem (sem credenciais, erro de conexão antes do envio, resposta
# HTTP de erro). Timeout de leitura ou conexão perdida após o envio respondem 502 sem fallback.
# Recusa parcial de destinatários no SMTP responde 200 com status "partial" e "refused".
SMTP_STARTTLS=true
FLASK_ENV=development
URL_AUTH=http://127.0.0.1:5050
URL_graph=http://127.0.0.1:5081/graphql
URL_restapi=http://127.0.0.1:5081/restapi
MINIO_URL=dwcorp.com.br:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
SERVER_NAME=labtech.dwcorp.com.br
SERVER_SCHEME=http
# chave que o Catalogo exige em /restapi e /graphql (um item do API_KEY_LIST dele); sem ela a API nao inicia
INTERNAL_API_KEY=
# so em desenvolvimento (FLASK_ENV=development): permite iniciar sem as chaves acima
ALLOW_INSECURE_DEV=false
# reserva quando True-Client-IP falta ou e invalido: proxies que acrescentam X-Forwarded-For antes da API (padrao 1); o IP do cliente e a entrada a essa distancia, da direita. No Render o cabecalho True-Client-IP da plataforma e usado primeiro
TRUSTED_PROXY_HOPS=1
# janela, em segundos, do limite de pedidos de link de login por cliente (padrao 900)
API_RATE_LIMIT_WINDOW_SECONDS=900
# opcional: segredo que assina os links de PDF enviados por e-mail; vazio = derivado de INTERNAL_API_KEY (trocar a chave invalida os links antigos)
LINK_SIGNING_KEY=
# validade, em dias, desses links (padrao 30)
PDF_LINK_TTL_DAYS=30
# true = serve /apidocs e /apispec_1.json (fechado por padrao)
ENABLE_API_DOCS=false
# origem do frontend que o navegador pode usar para chamar a API (CORS); sem ela e sem CORS_ALLOWED_ORIGINS nenhuma origem e aceita
FRONTEND_URL=
# origens extras, separadas por virgula (opcional)
CORS_ALLOWED_ORIGINS=
