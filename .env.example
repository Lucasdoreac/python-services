REACT_APP=localhost:3000
MONGO_DATABASE=rooms-reservation-app
MONGO_HOST=dwcorp.y5ugild.mongodb.net
MONGO_USERNAME=
MONGO_PASSWORD=
CLOUD_FUNCTION_URL=
CLOUD_FUNCTION_API_KEY=
FLASK_ENV=development
URL_AUTH=http://127.0.0.1:5050
URL_graph=http://127.0.0.1:5081/graphql
URL_restapi=http://127.0.0.1:5081/restapi
MINIO_URL=dwcorp.com.br:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
SERVER_NAME=labtech.dwcorp.com.br
SERVER_SCHEME=http
# opcional: URI completa do Mongo (por exemplo um Mongo local descartavel); sem ela vale a URI Atlas montada a partir de MONGO_HOST/MONGO_USERNAME/MONGO_PASSWORD
MONGO_URI=
# true = serve /apidocs e /apispec_1.json (fechado por padrao)
ENABLE_API_DOCS=false
# origem do frontend que o navegador pode usar para chamar a API (CORS); sem ela e sem CORS_ALLOWED_ORIGINS nenhuma origem e aceita
FRONTEND_URL=
# origens extras, separadas por virgula (opcional)
CORS_ALLOWED_ORIGINS=
# so em desenvolvimento (FLASK_ENV=development): abre o CORS e a documentacao
ALLOW_INSECURE_DEV=false
# opcional: chave enviada ao Catalogo no cabecalho x-api-key (tem de ser um item do API_KEY_LIST do Catalogo); sem ela nenhum cabecalho e enviado
INTERNAL_API_KEY=
# opcional, so para homologacao: enderecos exatos separados por virgula. Com ela definida, a API so entrega e-mail a esses enderecos e descarta os demais (o descarte e logado so como contagem); se nenhum sobrar, nada e enviado e a resposta do envio e um 202 local. Ausente ou vazia: nada muda
# EMAIL_RECIPIENT_ALLOWLIST=
# opcional: diretorio publico que tenha o dw-corp-logo.png usado no cabecalho dos e-mails; sem ele o logo e servido pela propria API em /static/email/
# EMAIL_ASSETS_URL=
